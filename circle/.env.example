# --- Database -------------------------------------------------------------
# Local: a SQLite file. On Vercel: a free Turso database (libsql://...),
# because SQLite files do not persist on Vercel.
DATABASE_URL="file:./dev.db"
# Only for Turso (libsql://...) databases:
DATABASE_AUTH_TOKEN=""
# Demo gigs and sample profiles are added automatically when the database has no gigs,
# and their dates are kept current. Set to "false" to start with an empty marketplace.
# Remove them any time with: npm run seed -- --remove
DEMO_DATA="true"

# --- Trustless Work (escrow engine) ---------------------------------------
# Request a testnet key in the Trustless Work dApp. Server-only: never NEXT_PUBLIC.
TRUSTLESS_WORK_API_KEY=""
TRUSTLESS_WORK_API_URL="https://dev.api.trustlesswork.com"

# --- Platform account (releases funds, resolves disputes, receives the fee) -
# Run `npm run keys` to generate one, fund it with Friendbot, add a USDC trustline.
PLATFORM_PUBLIC_KEY=""
PLATFORM_SECRET_KEY=""
# Wallets allowed to open /admin and resolve disputes (comma separated G... addresses).
ADMIN_ADDRESSES=""
# Circle fee in percent, taken on-chain at release.
PLATFORM_FEE_PERCENT="1"

# --- Sessions --------------------------------------------------------------
# Any long random string. `npm run keys` prints one.
SESSION_SECRET=""

# --- Stellar testnet -------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
NEXT_PUBLIC_HORIZON_URL="https://horizon-testnet.stellar.org"
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_USDC_ISSUER="GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5"
NEXT_PUBLIC_EXPLORER_URL="https://stellar.expert/explorer/testnet"
# What Trustless Work receives as the escrow "trustline". Defaults to the USDC issuer above.
# If deploy fails with a trustline error, try the USDC contract id instead:
# CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
ESCROW_TRUSTLINE_ADDRESS=""
